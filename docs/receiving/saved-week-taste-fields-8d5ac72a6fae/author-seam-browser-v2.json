  "runner": "import sys,json,termios,pathlib,subprocess,hashlib,os,gzip,base64\nattrs=termios.tcgetattr(sys.stdin.fileno())\nattrs[3] &= ~(termios.ECHO | termios.ICANON)\nattrs[6][termios.VMIN]=1\nattrs[6][termios.VTIME]=0\ntermios.tcsetattr(sys.stdin.fileno(),termios.TCSANOW,attrs)\nprint('{\"status\":\"ready-for-source\"}',flush=True)\npayload=json.loads(sys.stdin.readline())\nroot=pathlib.Path('/dev/hamon-8d5ac72a6fae/product/comma-witness')\nroot.mkdir(parents=True)\npins={}\nfor f in payload['source']:\n    p=root/f['path'];p.parent.mkdir(parents=True,exist_ok=True);p.write_text(f['content'])\n    data=p.read_bytes()\n    actual=hashlib.sha1(b'blob '+str(len(data)).encode()+b'\\0'+data).hexdigest()\n    assert actual==f['sha'],f['path']\n    pins[f['path']]={'git_blob':actual,'sha256':hashlib.sha256(data).hexdigest()}\n(root/'witness.mjs').write_text(payload['witness'])\n(root/'profiles.json').write_text(json.dumps(payload['profiles'],indent=2)+'\\n')\nenv=dict(os.environ,PYTHONDONTWRITEBYTECODE='1',NATIVE_PYTHON=sys.executable,TMPDIR=str(root),XDG_CACHE_HOME=str(root/'cache'))\ncases=[]\nfor case in payload['profiles']:\n    run=subprocess.run([sys.executable,'tastetable_cli.py','--profile','-'],cwd=root,input=json.dumps(case['profile']),text=True,capture_output=True,env=env)\n    assert run.returncode==0,run.stderr\n    (root/(case['name']+'-native-cli.json')).write_text(run.stdout)\n    cases.append({'name':case['name'],'record':json.loads(run.stdout)})\n(root/'native-cases.json').write_text(json.dumps(cases))\nrun=subprocess.run(['node','witness.mjs'],cwd=root,text=True,capture_output=True,env=env,timeout=60)\n(root/'browser.stdout').write_text(run.stdout)\n(root/'browser.stderr').write_text(run.stderr)\nfor filename,meta in pins.items():\n    assert hashlib.sha256((root/filename).read_bytes()).hexdigest()==meta['sha256'],filename\n(root/'source-pins.json').write_text(json.dumps(pins,indent=2)+'\\n')\n(root/'run.json').write_text(json.dumps({'returncode':run.returncode,'python':sys.version,'sourceUnchanged':True},indent=2)+'\\n')\nfiles={p.name:p.read_text() for p in root.iterdir() if p.is_file() and p.suffix in ['.json','.mjs','.stdout','.stderr']}\nraw=json.dumps({'schema':'tastetable-saved-week-comma-witness/1','files':files},ensure_ascii=False,separators=(',',':')).encode()\narchive=gzip.compress(raw,mtime=0)\nresult={'returncode':run.returncode,'stdout':run.stdout,'stderr':run.stderr,'sourceUnchanged':True,'packet':{'encoding':'base64','gzip_sha256':hashlib.sha256(archive).hexdigest(),'bytes':len(archive),'content':base64.b64encode(archive).decode()}}\nprint(json.dumps(result),flush=True)\n",
